<?xml version="1.0" encoding="utf-8"?>
<!-- This project has no NuGet package dependencies; it only needs the .NET
     framework/runtime packs from nuget.org. Clearing inherited sources keeps
     restore/publish from probing corporate feeds that aren't reachable off-network. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
