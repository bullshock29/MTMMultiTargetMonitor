<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Surfaces -->
    <SolidColorBrush x:Key="WindowBackground" Color="#16191D" />
    <SolidColorBrush x:Key="SurfaceBackground" Color="#1E2228" />
    <SolidColorBrush x:Key="SurfaceAltBackground" Color="#242931" />
    <SolidColorBrush x:Key="SunkenBackground" Color="#121519" />

    <!-- Lines -->
    <SolidColorBrush x:Key="DividerBrush" Color="#31383F" />
    <SolidColorBrush x:Key="StrongBorderBrush" Color="#424A54" />

    <!-- Text -->
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#E7EAED" />
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#9BA4B0" />
    <SolidColorBrush x:Key="DisabledTextBrush" Color="#606974" />

    <!-- Fields -->
    <SolidColorBrush x:Key="FieldBackground" Color="#14171B" />
    <SolidColorBrush x:Key="FieldBorderBrush" Color="#3A424D" />

    <!-- Accent (teal / green) -->
    <SolidColorBrush x:Key="AccentBrush" Color="#1FB8A6" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#33C6B5" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#18A090" />
    <SolidColorBrush x:Key="AccentForegroundBrush" Color="#08221E" />
    <SolidColorBrush x:Key="AccentSubtleBackground" Color="#331FB8A6" />

    <!-- Control interaction -->
    <SolidColorBrush x:Key="ControlHoverBackground" Color="#2B313A" />
    <SolidColorBrush x:Key="ControlPressedBackground" Color="#333B45" />

    <!-- State -->
    <SolidColorBrush x:Key="OkBrush" Color="#34C88A" />
    <SolidColorBrush x:Key="WarnBrush" Color="#E0A83D" />
    <SolidColorBrush x:Key="ErrorBrush" Color="#E5786B" />

    <!-- Monitor diagram -->
    <SolidColorBrush x:Key="MonitorSelectedFill" Color="#1FB8A6" />
    <SolidColorBrush x:Key="MonitorSelectedBorder" Color="#33C6B5" />
    <SolidColorBrush x:Key="MonitorSelectedText" Color="#08221E" />
    <SolidColorBrush x:Key="MonitorUnselectedFill" Color="#2B313A" />
    <SolidColorBrush x:Key="MonitorUnselectedBorder" Color="#3E4650" />
    <SolidColorBrush x:Key="MonitorUnselectedText" Color="#97A0AC" />

</ResourceDictionary>
