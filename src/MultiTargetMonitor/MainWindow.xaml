<Window x:Class="MultiTargetMonitor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="clr-namespace:MultiTargetMonitor.Controls"
        Title="{Binding WindowTitle}"
        Icon="/Assets/app.ico"
        Height="775" Width="820" MinHeight="640" MinWidth="700"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackground}"
        FontFamily="{DynamicResource AppFont}" FontSize="{DynamicResource FontSizeNormal}"
        TextOptions.TextFormattingMode="Display"
        AllowDrop="True" Drop="Window_Drop" DragOver="Window_DragOver">

    <DockPanel>

        <!-- ===================== Header ===================== -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource SurfaceAltBackground}"
                BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="14,9">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="/Assets/app-256.png" Width="26" Height="26"
                           RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center" />
                    <TextBlock FontSize="14" Margin="9,0,0,0" VerticalAlignment="Center">
                        <Run Text="MTM" FontWeight="Bold" />
                        <Run Text="  Multi Target Monitor" FontWeight="SemiBold"
                             Foreground="{DynamicResource SecondaryTextBrush}" />
                    </TextBlock>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="New" Style="{StaticResource SubtleButton}" Click="New_Click" />
                    <Button Content="Open" Style="{StaticResource SubtleButton}" Click="Open_Click" />
                    <Button Content="Save" Style="{StaticResource SubtleButton}" Click="Save_Click" />
                    <Border Width="1" Background="{DynamicResource DividerBrush}" Margin="7,5" />

                    <ToggleButton x:Name="ThemeToggle" Style="{StaticResource SubtleToggleButton}"
                                  FontSize="15" Content="&#x25D1;" ToolTip="Theme" />
                    <Popup PlacementTarget="{Binding ElementName=ThemeToggle}" Placement="Bottom"
                           HorizontalOffset="-90" VerticalOffset="6" AllowsTransparency="True"
                           StaysOpen="False" PopupAnimation="Fade"
                           IsOpen="{Binding IsChecked, ElementName=ThemeToggle, Mode=TwoWay}">
                        <Border Style="{StaticResource PopupCard}" Padding="5" MinWidth="150">
                            <StackPanel>
                                <Button x:Name="ThemeLightBtn" Style="{StaticResource MenuRowButton}"
                                        Content="Light" Click="ThemeLight_Click" />
                                <Button x:Name="ThemeDarkBtn" Style="{StaticResource MenuRowButton}"
                                        Content="Dark" Click="ThemeDark_Click" />
                                <Button x:Name="ThemeSystemBtn" Style="{StaticResource MenuRowButton}"
                                        Content="Match Windows" Click="ThemeSystem_Click" />
                            </StackPanel>
                        </Border>
                    </Popup>

                    <ToggleButton x:Name="MenuToggle" Style="{StaticResource SubtleToggleButton}"
                                  FontSize="17" Content="&#x22EF;" ToolTip="More" />
                    <Popup PlacementTarget="{Binding ElementName=MenuToggle}" Placement="Bottom"
                           HorizontalOffset="-210" VerticalOffset="6" AllowsTransparency="True"
                           StaysOpen="False" PopupAnimation="Fade"
                           IsOpen="{Binding IsChecked, ElementName=MenuToggle, Mode=TwoWay}">
                        <Border Style="{StaticResource PopupCard}" Padding="5" MinWidth="250">
                            <StackPanel>
                                <Button Style="{StaticResource MenuRowButton}" Content="Preview .rdp file…"
                                        Click="Preview_Click" />
                                <Button Style="{StaticResource MenuRowButton}" Content="Refresh monitor list"
                                        Click="Refresh_Click" />
                                <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="6,4" />
                                <Button x:Name="ShellRegisterBtn" Style="{StaticResource MenuRowButton}"
                                        Content="Add to Windows &quot;Open with&quot; menu" Click="ToggleRegister_Click" />
                                <Button Style="{StaticResource MenuRowButton}" Content="Set as default for .rdp files…"
                                        Click="MakeDefault_Click" />
                                <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="6,4" />
                                <Button Style="{StaticResource MenuRowButton}" Content="About" Click="About_Click" />
                            </StackPanel>
                        </Border>
                    </Popup>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===================== Footer ===================== -->
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource SurfaceAltBackground}"
                BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0">
            <DockPanel Margin="14,10">
                <TextBlock x:Name="StatusText" VerticalAlignment="Center"
                           Foreground="{DynamicResource SecondaryTextBrush}" TextTrimming="CharacterEllipsis" />
                <Button Content="Connect" Style="{StaticResource AccentButton}" DockPanel.Dock="Right"
                        MinWidth="104" Click="Connect_Click" IsEnabled="{Binding CanConnect}" />
            </DockPanel>
        </Border>

        <!-- ===================== Body ===================== -->
        <TabControl Margin="18,14,18,14">

            <TabItem Header="General">
                <Border Style="{StaticResource Card}" Padding="22" VerticalAlignment="Top">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Style="{StaticResource SectionHeading}"
                                   Text="Connection" Margin="0,0,0,14" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Computer" Margin="0,0,14,12"
                                   VerticalAlignment="Center" />
                        <TextBox Grid.Row="1" Grid.Column="1" Margin="0,0,0,12"
                                 Text="{Binding Computer, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="User name" Margin="0,0,14,12"
                                   VerticalAlignment="Center" />
                        <TextBox Grid.Row="2" Grid.Column="1" Margin="0,0,0,12"
                                 Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource Caption}" TextWrapping="Wrap"
                                   Text="Enter the PC name and optional user. Choose monitors on the Display tab, then Save the .rdp file and Connect to launch it. Existing files keep every other setting untouched." />
                    </Grid>
                </Border>
            </TabItem>

            <TabItem Header="Display">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" MinHeight="300" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Monitors card -->
                    <Border Grid.Row="0" Style="{StaticResource Card}" Padding="18">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Style="{StaticResource SectionHeading}"
                                       Text="Monitors" Margin="0,0,0,10" />

                            <CheckBox DockPanel.Dock="Top" Margin="0,0,0,6"
                                      Content="Use all of my monitors for the remote session"
                                      IsChecked="{Binding UseAllMonitors}" />
                            <TextBlock DockPanel.Dock="Top" Style="{StaticResource Caption}" TextWrapping="Wrap"
                                       Margin="0,0,0,12"
                                       Text="Or click monitors to choose exactly which ones the session spans. The number on each is its selectedmonitors id." />

                            <ScrollViewer DockPanel.Dock="Bottom" MaxHeight="94" Margin="0,10,0,0"
                                          VerticalScrollBarVisibility="Auto"
                                          IsEnabled="{Binding PerMonitorEnabled}">
                                <ItemsControl ItemsSource="{Binding Monitors}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsSelected}" Margin="0,1"
                                                      HorizontalContentAlignment="Stretch">
                                                <Border Padding="9,5" CornerRadius="6" BorderThickness="1">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="{DynamicResource SurfaceAltBackground}" />
                                                            <Setter Property="BorderBrush" Value="Transparent" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                    <Setter Property="Background" Value="{DynamicResource AccentSubtleBackground}" />
                                                                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Info.Id, StringFormat=#{0}}"
                                                                   FontWeight="SemiBold" MinWidth="34" />
                                                        <TextBlock Text="{Binding Info.Resolution}" Margin="6,0,0,0" />
                                                        <TextBlock Text="primary" Margin="10,0,0,0"
                                                                   Foreground="{DynamicResource AccentBrush}"
                                                                   FontSize="11" VerticalAlignment="Center"
                                                                   Visibility="{Binding Info.IsPrimary, Converter={StaticResource BoolToVis}}" />
                                                        <TextBlock Text="{Binding Info.Device}" Margin="12,0,0,0"
                                                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                                                   FontSize="11.5" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Border>
                                            </CheckBox>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <Border Background="{DynamicResource SunkenBackground}" CornerRadius="6"
                                    MinHeight="150" IsEnabled="{Binding PerMonitorEnabled}">
                                <ctl:MonitorLayoutControl x:Name="Layout"
                                                          Monitors="{Binding Monitors}"
                                                          IsEnabled="{Binding PerMonitorEnabled}"
                                                          SelectedFill="{DynamicResource MonitorSelectedFill}"
                                                          SelectedBorder="{DynamicResource MonitorSelectedBorder}"
                                                          SelectedText="{DynamicResource MonitorSelectedText}"
                                                          UnselectedFill="{DynamicResource MonitorUnselectedFill}"
                                                          UnselectedBorder="{DynamicResource MonitorUnselectedBorder}"
                                                          UnselectedText="{DynamicResource MonitorUnselectedText}" />
                            </Border>
                        </DockPanel>
                    </Border>

                    <!-- Output card -->
                    <Border Grid.Row="1" Style="{StaticResource Card}" Padding="16,13" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Caption}" Text="WILL BE WRITTEN AS" />
                            <TextBlock Text="{Binding PreviewText}" FontFamily="Consolas, monospace"
                                       TextWrapping="Wrap" Margin="0,3,0,0" />
                            <TextBlock Text="{Binding ValidationText}" TextWrapping="Wrap" Margin="0,7,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                        <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ValidationSeverity}" Value="Ok">
                                                <Setter Property="Foreground" Value="{DynamicResource OkBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding ValidationSeverity}" Value="Warning">
                                                <Setter Property="Foreground" Value="{DynamicResource WarnBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding ValidationSeverity}" Value="Error">
                                                <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,6,0,0"
                                       Text="Native resolution per monitor. Multi-monitor picks also disable dynamic resolution and smart sizing, which would otherwise stretch one desktop across the screens." />
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
